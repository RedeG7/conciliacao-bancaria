{$DOMINIO} {
	# /api/* vai pra API nova (attended_worker sincroniza so com
	# usuario/senha - ver api.py) - "handle" (nao "handle_path") preserva
	# o prefixo /api no caminho encaminhado, que e o que as rotas do
	# FastAPI esperam (@app.post("/api/login") etc.).
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy app:8501
	}
}

# Admissoes (modulo do proprio Hub): o subdominio so leva para a tela de
# Admissoes no Hub - assim vale o login do Hub (o cookie de sessao e do
# dominio do Hub). Precisa do registro DNS A "admissao" apontando pro VPS.
{$DOMINIO_ADMISSAO:admissao.redeg7.com} {
	redir https://{$DOMINIO}/?tela=admissoes 302
}

# Real 4U - Marketing & Comercial (servico "marketing" do docker-compose).
{$DOMINIO_MARKETING:mkt.redeg7.com} {
	reverse_proxy marketing:3000
}

# Honorarios Control (repo RedeG7/honorariocontrol, em /opt/honorarios).
# O container do app entra na rede deste compose com o alias
# "honorarios-app" (deploy/compose.proxy-hub.yml daquele repo). Se ele
# estiver fora do ar, so este site responde 502; o Hub nao e afetado.
{$DOMINIO_HONORARIOS:honorarios.redeg7.com} {
	reverse_proxy honorarios-app:5000
}

# Dominio oficial do Honorarios Control (mesmo app acima). O "www" e
# redirecionado para o dominio sem www pelo proprio app.
honorarioscontrol.com.br, www.honorarioscontrol.com.br {
	reverse_proxy honorarios-app:5000
}

# Simulador INSS Obras (servico "inssobras" do docker-compose, pasta
# inss-obras/). Precisa do registro DNS A "inssobras" apontando pro VPS.
{$DOMINIO_INSSOBRAS:inssobras.redeg7.com} {
	reverse_proxy inssobras:3000
}

# RH (servico "rh" do docker-compose, pasta rh/). Precisa do registro DNS A
# "rh" apontando pro VPS.
{$DOMINIO_RH:rh.redeg7.com} {
	reverse_proxy rh:3000
}

# WhatsApp Disparos / AutoEnvioPro (servico "whatsapp" do docker-compose,
# pasta whatsapp/), no dominio proprio autoenviopro.com.br. Precisa dos
# registros DNS A do dominio e do "www" apontando pro VPS; o "www" so
# redireciona para o dominio sem www.
{$DOMINIO_WHATSAPP:autoenviopro.com.br} {
	reverse_proxy whatsapp:3000
}

www.{$DOMINIO_WHATSAPP:autoenviopro.com.br} {
	redir https://{$DOMINIO_WHATSAPP:autoenviopro.com.br}{uri} permanent
}
