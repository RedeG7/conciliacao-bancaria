{$DOMINIO} {
	# /api/* vai pra API nova (attended_worker sincroniza so com
	# usuario/senha - ver api.py) - "handle" (nao "handle_path") preserva
	# o prefixo /api no caminho encaminhado, que e o que as rotas do
	# FastAPI esperam (@app.post("/api/login") etc.).
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy app:8501
	}
}

# Real 4U - Marketing & Comercial (servico "marketing" do docker-compose).
{$DOMINIO_MARKETING:mkt.redeg7.com} {
	reverse_proxy marketing:3000
}

# Honorarios Control (repo RedeG7/honorariocontrol, em /opt/honorarios).
# O container do app entra na rede deste compose com o alias
# "honorarios-app" (deploy/compose.proxy-hub.yml daquele repo). Se ele
# estiver fora do ar, so este site responde 502; o Hub nao e afetado.
{$DOMINIO_HONORARIOS:honorarios.redeg7.com} {
	reverse_proxy honorarios-app:5000
}

# Dominio oficial do Honorarios Control (mesmo app acima). O "www" e
# redirecionado para o dominio sem www pelo proprio app.
honorarioscontrol.com.br, www.honorarioscontrol.com.br {
	reverse_proxy honorarios-app:5000
}

# TechSupportCRM - Suporte RedeG7 / helpdesk (repo RedeG7/TechSupportCRM, em
# /opt/techsupport). Mesmo modelo do Honorarios: o container entra na rede
# deste compose com o alias "techsupport-app" (deploy/compose.proxy-hub.yml
# daquele repo). Fora do ar, so este site responde 502.
{$DOMINIO_SUPORTE:suporte.redeg7.com} {
	reverse_proxy techsupport-app:5000
}
