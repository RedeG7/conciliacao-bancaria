# Copie para .env no servidor (NAO commitar o .env real) e ajuste:
DOMINIO=conciliacao.seudominio.com.br

# Gere uma senha forte so para o Postgres, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha

# Chave de cifra das credenciais do hub de RPA (procurador de portais
# externos, ex.: ISS Web). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO: perder esta chave torna as credenciais ja salvas irrecuperaveis
# (precisa recadastrar) - guarde uma copia em lugar seguro, fora do VPS.
RPA_ENC_KEY=troque-esta-chave

# Real 4U - Marketing & Comercial (CRM, pasta marketing/). Liga o servico
# (profile do docker-compose). O deploy do GitHub Actions acrescenta esta
# linha sozinho quando o pacote real4u-marketing ficar publico no GHCR
# (ver DEPLOY.md).
COMPOSE_PROFILES=marketing
# Subdominio proprio, com registro DNS A apontando pro IP deste VPS (o
# Caddy emite o HTTPS sozinho). O card "Marketing & Comercial" da home do Hub abre ele.
# (opcional - o padrao do docker-compose ja e mkt.redeg7.com)
DOMINIO_MARKETING=mkt.redeg7.com
# Opcional: liga o recebimento do formulario do site em
# POST https://DOMINIO_MARKETING/api/webhooks/form (gere com openssl rand -hex 32)
FORM_WEBHOOK_TOKEN=
# Opcional: ID do usuario do CRM responsavel pelos leads do formulario
FORM_DEFAULT_OWNER_ID=
