# Copie para .env no servidor (NAO commitar o .env real) e ajuste:
DOMINIO=conciliacao.seudominio.com.br

# Gere uma senha forte so para o Postgres, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha

# Chave de cifra das credenciais do hub de RPA (procurador de portais
# externos, ex.: ISS Web). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO: perder esta chave torna as credenciais ja salvas irrecuperaveis
# (precisa recadastrar) - guarde uma copia em lugar seguro, fora do VPS.
RPA_ENC_KEY=troque-esta-chave
