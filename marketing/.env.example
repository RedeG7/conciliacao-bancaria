# Copie para as variáveis de ambiente da hospedagem
PORT=3000
DATA_DIR=/data
COOKIE_SECURE=1
TRUST_PROXY=1
# Código secreto longo para o formulário do site enviar contatos (gere um aleatório)
FORM_WEBHOOK_TOKEN=troque-por-um-codigo-longo-e-aleatorio
# Opcional: ID do usuário responsável pelos leads vindos do formulário
FORM_DEFAULT_OWNER_ID=
